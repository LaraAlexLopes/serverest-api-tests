{
  "type": "object",
  "required": ["quantidade", "usuarios"],
  "properties": {
    "quantidade": { "type": "integer", "minimum": 0 },
    "usuarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nome", "email", "administrador", "_id"],
        "properties": {
          "nome": { "type": "string" },
          "email": { "type": "string" },
          "administrador": { "enum": ["true", "false"] },
          "_id": { "type": "string" }
        }
      }
    }
  }
}
